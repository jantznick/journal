# Copy to backend/.env for local development.
# For Compose deploy, copy to .env at the repo root.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/journal?schema=public"
SESSION_SECRET="change-this-to-a-long-random-string"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Compose / production cookie settings (local Compose on HTTP: leave COOKIE_SECURE=false)
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax

# Resend — magic-link email. When unset in development, codes/links are logged to the console.
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="journal@yourdomain.com"

# OpenAI (prompt generation + insights). Leave unset to use local fallback prompts.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# Optional: point at a local OpenAI-compatible server later
# OPENAI_BASE_URL=""

# Optional OIDC (Authentik, Keycloak, etc.). When all three are set, SSO appears on login.
# OIDC_ISSUER_URL="https://auth.example.com/application/o/journal/"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI="http://localhost:3001/api/auth/oidc/callback"
# OIDC_SCOPE="openid profile email"

# Compose-only (root .env)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=journal
